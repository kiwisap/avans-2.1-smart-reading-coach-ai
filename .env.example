# Path to the trained model (default: models/hybrid_model.joblib)
MODEL_PATH=models/hybrid_model.joblib

# Shared secret: the Fastify backend sends it in the X-API-Key header. Leave empty for local development.
AI_API_KEY=

# MongoDB of the backend. The catalog is read from it (collection books) and the learned synonyms
# are written to it (collection topic_synonyms). Leave empty to use only the xlsx.
# From the docker compose service, the MongoDB of the backend on this computer is host.docker.internal.
MONGO_URL=
MONGO_DB=smart_reading_coach_files

# Train once more on the MongoDB catalog when the service starts (true or false)
TRAIN_ON_START=true
